import { $fetch } from "@/lib/better-fetch";
import z from "zod";

interface SearchUsersByUsernameRequest {
	username?: string
}

const searchUsersByUsernameResponseSchema = z.object({
	users: z.array(z.object({
		name: z.string(),
		username: z.string(),
		email: z.string(),
		image: z.string().optional().nullish(),
	})),
	total: z.number(),
	page: z.number(),
	limit: z.number(),
})

type SearchUsersByUsernameResponseData = z.infer<typeof searchUsersByUsernameResponseSchema>

interface SearchUsersByUsernameResponse {
	data: SearchUsersByUsernameResponseData | null,
	error: Error | null,
}


export async function SearchUsersByUsername(params: SearchUsersByUsernameRequest): Promise<SearchUsersByUsernameResponse> {
	try {
		const result = await $fetch("/users", {
			query: {
				username: params.username,
			},
			output: searchUsersByUsernameResponseSchema,
		})
		return {
			data: result.data,
			error: null,
		}
	} catch (err) {
		return {
			data: null,
			error: err
		}
	}

	return result
}
